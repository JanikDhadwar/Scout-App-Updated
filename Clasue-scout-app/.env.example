# Server only. Copy settings into .env. Never commit real keys.
TBA_API_KEY=
MATCH13_API_KEY=
# Set to loopback ONLY for a trusted same-host proxy such as cloudflared.
# Leave unset for direct access. Never expose a trusted local proxy to strangers.
ARGUS_TRUST_PROXY=
# Optional public rollout controls. Defaults preserve existing behavior.
# Restart through the authorized release process after changing these settings.
ARGUS_SIGNUP_ENABLED=true
ARGUS_TEAM_CREATION_ENABLED=true
# Blank means no admission cap. Choose caps from verified capacity evidence.
# Retained accounts/workspaces, including archived ones, count toward these caps.
ARGUS_MAX_USERS=
ARGUS_MAX_TEAMS=
