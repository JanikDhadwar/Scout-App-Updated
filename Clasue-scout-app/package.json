{
  "name": "scout-app",
  "private": true,
  "version": "5.13.0",
  "type": "module",
  "scripts": {
    "start": "node server.cjs",
    "test:browser": "node ../scripts/run-browser-checks.cjs",
    "test:browser:expansion": "node ../scripts/run-browser-checks.cjs --expansion",
    "test": "node --test ../scripts/deploy-status.test.cjs *.test.cjs src/form-conditions.test.js src/offline-client.test.js src/argus/*.test.js",
    "dev": "concurrently \"node server.cjs\" \"vite\"",
    "build": "vite build",
    "lint": "eslint .",
    "lint:active": "eslint src/frc-scout-local.jsx src/argus src/offline*.js src/form-conditions*.js src/use-report-draft.js src/report-media.jsx *.cjs vite.config.js",
    "preview": "vite preview",
    "test:readiness": "node ../scripts/readiness-load.cjs",
    "notices": "node ../scripts/dependency-notices.cjs",
    "test:accessibility": "node ../scripts/run-browser-checks.cjs --accessibility",
    "security:scan": "node ../scripts/security-scan.cjs"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/cli": "^0.1.22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.5.0",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "image-size": "^2.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
